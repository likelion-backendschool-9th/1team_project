POSTGRES_DB=dipsource
POSTGRES_USER=dipsource
POSTGRES_PASSWORD=dipsource

JWT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
FRONTEND_BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 통합 검색(Elasticsearch). 운영은 docker-compose.prod.yml 주석을 참고
SEARCH_ES_ENABLED=true
SEARCH_ENGINE=elasticsearch
# 운영에서만 사용
ELASTIC_PASSWORD=

# Cloudflare R2. R2_ENABLED=true일 때 이미지 업로드와 데모 업로드가 켜진다 (docs/데모-플랫폼-배포.md)
R2_ENABLED=false
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# 이미지용 공개 버킷
R2_BUCKET=
R2_PUBLIC_URL=
# 데모 파일용 비공개 버킷. 공개 접근을 켜지 않는다
R2_DEMO_BUCKET=dipsource-demos
# 배포한 데모 실행 Worker 주소 (끝에 / 없이)
DEMO_WORKER_BASE_URL=http://localhost:8787
# 미리보기 URL 서명 키. Worker의 DEMO_SIGNING_SECRET과 같은 값 (openssl rand -base64 32)
DEMO_SIGNING_SECRET=
# 사용자별 제한 (선택, 기본값: 데모 20개, 200MB, 데모당 버전 10개)
DEMO_QUOTA_MAX_DEMOS=20
DEMO_QUOTA_MAX_STORAGE_BYTES=209715200
DEMO_QUOTA_MAX_VERSIONS=10
# 자동 썸네일 (Cloudflare Browser Run). 끄면 기본 썸네일을 쓴다
DEMO_THUMBNAIL_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_API_TOKEN=
# 외부 백엔드 상태 확인. 켜면 서버가 업로더가 입력한 도메인으로 요청을 보낸다. 서버 아웃바운드 방화벽 검토 후 켠다
DEMO_BACKEND_HEALTH_ENABLED=false
