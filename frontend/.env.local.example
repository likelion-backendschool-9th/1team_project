# 백엔드 주소. 비워 두면 목 데이터로 화면을 확인한다.
# GitHub/카카오/구글 실로그인 테스트 시:
#   API_ORIGIN=http://localhost:8080
API_ORIGIN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DM 실시간(STOMP) 주소. 비워 두면 DM을 목업처럼 화면에만 추가한다. 예: ws://localhost:8080/ws
NEXT_PUBLIC_WS_URL=

# 1이면 비로그인(게스트) 화면을 목 데이터로 확인한다. (목 모드에서만 의미 있음)
MOCK_GUEST=

# 임시: 1이면 백엔드가 있어도 DM·로그인 정보만 실서버를 쓰고 나머지는 목 데이터를 쓴다. (docs/임시-목업-현황.md)
MOCK_EXCEPT_DM=
