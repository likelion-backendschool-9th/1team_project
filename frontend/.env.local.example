# 백엔드 주소. 비워 두면 목 데이터로 화면을 확인한다.
# GitHub/카카오/구글 실로그인 테스트 시:
#   API_ORIGIN=http://localhost:8080
API_ORIGIN=

# 브라우저가 이동할 백엔드 주소(로그인 리다이렉트용).
# 로컬은 설정하지 않아도 된다 — 없으면 API_ORIGIN을 쓴다. Docker·배포에서는 compose에서 ""로 준다.
# BROWSER_API_ORIGIN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DM 실시간(STOMP) 주소. 비워 두면 DM이 서버로 전송되지 않고 화면에만 추가된다.
# 로컬에서 실제 DM을 주고받으려면 꼭 채운다. (Docker·배포는 Dockerfile 기본값 /api/v1/ws 사용)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# 1이면 비로그인(게스트) 화면을 목 데이터로 확인한다. (목 모드에서만 의미 있음)
MOCK_GUEST=

# 임시: 1이면 백엔드가 있어도 DM·로그인 정보만 실서버를 쓰고 나머지는 목 데이터를 쓴다. (docs/임시-목업-현황.md)
MOCK_EXCEPT_DM=
